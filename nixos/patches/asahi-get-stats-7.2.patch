     #[allow(clippy::vec_box)]
     #[pin]
     garbage_contexts: Mutex<KVec<KBox<fw::types::GpuObject<fw::workqueue::GpuContextData>>>>,
@@ -322,6 +324,10 @@ fn handle_channel_error(
     fn get_cfg(&self) -> &'static hw::HwConfig;
