     fn get_dyncfg(&self) -> &hw::DynConfig;
+    /// Take a snapshot of the GPU statistics, see `drm_asahi_get_stats`.
+    ///
+    /// This also restarts the utilisation measurement window.
+    fn stats_snapshot(&self) -> channel::StatsSnapshot;
     /// Register an unused context as garbage
     fn free_context(&self, data: KBox<fw::types::GpuObject<fw::workqueue::GpuContextData>>);
     /// Check whether the GPU is crashed
@@ -730,6 +736,8 @@ fn make_mgr(
         let buffer_mgr = buffer::BufferManager::ver::new()?;
         let event_manager_clone = event_manager.clone();
         let buffer_mgr_clone = buffer_mgr.clone();
+        let stats = Arc::pin_init(new_mutex!(channel::StatsState::default(), "stats"), GFP_KERNEL)?;
+        let stats_rx = stats.clone();
         let alloc_ref = &mut alloc;
         let rx_channels = KBox::init(
             try_init!(RxChannels::ver {
@@ -741,7 +749,7 @@ fn make_mgr(
                 )?,
                 fw_log: channel::FwLogChannel::new(dev.into(), alloc_ref)?,
                 ktrace: channel::KTraceChannel::new(dev.into(), alloc_ref)?,
-                stats: channel::StatsChannel::ver::new(dev.into(), alloc_ref)?,
+                stats: channel::StatsChannel::ver::new(dev.into(), alloc_ref, stats_rx)?,
             }),
             GFP_KERNEL,
         )?;
@@ -773,6 +781,7 @@ fn make_mgr(
                 pipes,
                 buffer_mgr,
                 ids: Default::default(),
+                stats,
                 garbage_contexts <- new_mutex!(KVec::new(), "garbage_contexts"),
             }),
             GFP_KERNEL,
@@ -1151,6 +1160,7 @@ pub(crate) fn start_op(self: &Arc<GpuManager::ver>) -> Result<OpGuard> {
 
         mod_dev_dbg!(self.dev, "OP start (pending: {})\n", val + 1);
         self.kick_firmware()?;
+        self.stats.lock().op_start();
         Ok(OpGuard(self.clone()))
     }
 
@@ -1585,6 +1595,20 @@ fn get_dyncfg(&self) -> &hw::DynConfig {
         &self.dyncfg
     }
 
+    fn stats_snapshot(&self) -> channel::StatsSnapshot {
+        let mut snapshot = self.stats.lock().snapshot();
+
+        // The firmware reports a performance state index, map it to a clock rate using the
+        // operating points read from the device tree.
+        if let Some(pstate) = snapshot.pstate {
+            if let Some(state) = self.dyncfg.pwr.perf_states.get(pstate as usize) {
+                snapshot.frequency_khz = Some(state.freq_hz / 1000);
+            }
+        }
+
+        snapshot
+    }
+
     fn free_context(&self, ctx: KBox<fw::types::GpuObject<fw::workqueue::GpuContextData>>) {
         let mut garbage = self.garbage_contexts.lock();
 
@@ -1625,5 +1649,7 @@ fn end_op(&self) {
             .with(|raw, _inner| raw.pending_submissions.fetch_sub(1, Ordering::Release));
 
         mod_dev_dbg!(self.dev, "OP end (pending: {})\n", val - 1);
+
+        self.stats.lock().op_end();
     }
 }
diff --git a/include/uapi/drm/asahi_drm.h b/include/uapi/drm/asahi_drm.h
index de67f1c603af..6fd4df1eefd5 100644
--- a/include/uapi/drm/asahi_drm.h
+++ b/include/uapi/drm/asahi_drm.h
@@ -93,6 +93,9 @@ enum drm_asahi_ioctl_id {
 
 	/** @DRM_ASAHI_SUBMIT: Submit commands to a queue. */
 	DRM_ASAHI_SUBMIT,
+
+	/** @DRM_ASAHI_GET_STATS: Query GPU utilisation and power state statistics. */
+	DRM_ASAHI_GET_STATS,
 };
 
 #define DRM_ASAHI_MAX_CLUSTERS	64
@@ -1157,6 +1160,84 @@ struct drm_asahi_get_time {
 	__u64 gpu_timestamp;
 };
 
+/**
+ * define DRM_ASAHI_STAT_BUSY - &drm_asahi_get_stats.busy_percent is valid.
+ */
+#define DRM_ASAHI_STAT_BUSY	(1 << 0)
+
+/**
+ * define DRM_ASAHI_STAT_PSTATE - &drm_asahi_get_stats.pstate is valid.
+ */
+#define DRM_ASAHI_STAT_PSTATE	(1 << 1)
+
+/**
+ * define DRM_ASAHI_STAT_FREQ - &drm_asahi_get_stats.frequency_khz is valid.
+ */
+#define DRM_ASAHI_STAT_FREQ	(1 << 2)
+
+/**
+ * define DRM_ASAHI_STAT_POWER - &drm_asahi_get_stats.power_uw is valid.
+ */
+#define DRM_ASAHI_STAT_POWER	(1 << 3)
+
+/**
+ * define DRM_ASAHI_STAT_TEMP - &drm_asahi_get_stats.temp_mcelsius is valid.
+ */
+#define DRM_ASAHI_STAT_TEMP	(1 << 4)
+
+/**
+ * struct drm_asahi_get_stats - Arguments passed to DRM_IOCTL_ASAHI_GET_STATS
+ *
+ * Only the fields flagged in @valid by the driver carry data, all other fields
+ * are left untouched. A driver that does not implement this ioctl fails it with
+ * EINVAL, like any unknown Asahi ioctl.
+ *
+ * The counters are sampled: @busy_percent describes the fraction of the time
+ * the driver had work in flight since the previous DRM_IOCTL_ASAHI_GET_STATS
+ * call on this device (the measurement window is shared by all clients, so a
+ * client only sees the window since the last call from any client), while
+ * @gpu_busy_ns and @gpu_idle_ns are totals since the driver was initialised and
+ * can be used to build windows of any length. The remaining fields are
+ * point-in-time values.
+ */
+struct drm_asahi_get_stats {
+	/** @flags: MBZ. */
+	__u64 flags;
+
+	/**
+	 * @timestamp_ns: On return, driver monotonic time (CLOCK_MONOTONIC) of
+	 * the sample, in nanoseconds.
+	 */
+	__u64 timestamp_ns;
+
+	/** @valid: Bitmask of DRM_ASAHI_STAT_xxx. */
+	__u32 valid;
+
+	/** @busy_percent: Utilisation of the last window, in percent (0-100). */
+	__u32 busy_percent;
+
+	/** @gpu_busy_ns: Nanoseconds with GPU work in flight since init. */
+	__u64 gpu_busy_ns;
+
+	/** @gpu_idle_ns: Nanoseconds without GPU work in flight since init. */
+	__u64 gpu_idle_ns;
+
+	/** @pstate: Current GPU performance state index. */
+	__u32 pstate;
+
+	/** @frequency_khz: GPU core clock of @pstate, in kilohertz. */
+	__u32 frequency_khz;
+
+	/** @power_uw: GPU power consumption in microwatts. */
+	__u64 power_uw;
+
+	/** @temp_mcelsius: GPU temperature in milli-degrees Celsius. */
+	__s32 temp_mcelsius;
+
+	/** @pad: MBZ. */
+	__u32 pad;
+};
+
 /**
  * DRM_IOCTL_ASAHI() - Build an Asahi IOCTL number
  * @__access: Access type. Must be R, W or RW.
@@ -1185,6 +1266,7 @@ enum {
 	DRM_IOCTL_ASAHI_QUEUE_CREATE     = DRM_IOCTL_ASAHI(WR, QUEUE_CREATE, queue_create),
 	DRM_IOCTL_ASAHI_QUEUE_DESTROY    = DRM_IOCTL_ASAHI(W, QUEUE_DESTROY, queue_destroy),
 	DRM_IOCTL_ASAHI_SUBMIT           = DRM_IOCTL_ASAHI(W, SUBMIT, submit),
+	DRM_IOCTL_ASAHI_GET_STATS        = DRM_IOCTL_ASAHI(WR, GET_STATS, get_stats),
 };
 
